{
  "manifest_version": 3,
  "name": "Lux Job Application Assistant",
  "version": "1.0.0",
  "description": "Job application tracker and JD analyzer.",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "*://*.linkedin.com/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/popup.html"
  },
  "options_page": "src/options/options.html"
}
